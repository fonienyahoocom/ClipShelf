<Application x:Class="ClipShelf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#CCFBF1"/>
        <SolidColorBrush x:Key="TextBrush" Color="#16202A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#708090"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F8FAFC"/>
    </Application.Resources>
</Application>
