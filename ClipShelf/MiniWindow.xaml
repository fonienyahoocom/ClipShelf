<Window x:Class="ClipShelf.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="66" Height="66" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True">
    <Border x:Name="BubbleBorder" Width="58" Height="58" CornerRadius="18" Background="#0F766E"
            BorderBrush="#D5F5EF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
            MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseRightButtonUp="Bubble_MouseRightButtonUp"
            ToolTip="ClipShelf｜拖曳移動，點一下打開">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <TextBlock Text="▣" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Width="15" Height="15" CornerRadius="8"
                    Background="#ECFEFF" BorderBrush="#99F6E4" BorderThickness="1">
                <TextBlock Text="C" FontSize="9" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
