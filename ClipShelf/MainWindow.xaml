<Window x:Class="ClipShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipShelf 剪貼庫" Width="930" Height="620"
        MinWidth="480" MinHeight="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="White"
        ResizeMode="CanResize" Topmost="False" ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="HeaderPrimaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="#0F5F59"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#147D75"/>
            <Setter Property="BorderBrush" Value="#4CA49D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#0F766E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardDangerActionButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF1F2"/>
                    <Setter Property="BorderBrush" Value="#FECDD3"/>
                    <Setter Property="Foreground" Value="#BE123C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="ViewModeButton" TargetType="RadioButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#CCFBF1"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#0D9488"/>
                                <Setter Property="Foreground" Value="#0F766E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="#0F766E" MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseRightButtonUp="Header_MouseRightButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="▣" FontSize="28" Foreground="White" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="剪貼庫" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <Button Content="▤ 快捷選取" FontSize="11" Padding="4,1" Margin="0,2,0,0" Background="#DFF2EF" Click="QuickPicker_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,17,12,17" Background="#DFF2EF" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontSize="20" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 FontSize="13.5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                                 ToolTip="搜尋文字、標題、備註與資料夾；空格分隔多個關鍵字"/>
                        <Button Grid.Column="2" x:Name="ClearSearchButton" Content="×" FontSize="20" Background="Transparent" BorderThickness="0"
                                Foreground="#64748B" Click="ClearSearchButton_Click"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource HeaderPrimaryActionButton}" Content="＋ 新增文字" ToolTip="新增一筆文字" Click="AddText_Click"/>
                    <Button x:Name="CaptureToggleButton" Style="{StaticResource HeaderActionButton}" Content="暫停" ToolTip="暫停自動保存" Click="CaptureToggle_Click"/>
                    <Button Style="{StaticResource HeaderActionButton}" Content="備份 ▾" ToolTip="匯出完整備份／匯入前預掃描去重" Click="BackupMenu_Click"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="⚙" ToolTip="設定" Click="Settings_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource HeaderIconButton}" Content="□" ToolTip="最大化 / 還原" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="—" ToolTip="最小化 / 不干擾模式時縮成浮動圖示" Click="MinimizeButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="176" MinWidth="110" MaxWidth="320"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8FAFC">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,10,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="資料夾" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="＋" Width="28" Height="28" Padding="0" FontSize="18" Background="Transparent" BorderThickness="0"
                                    Foreground="#0F766E" ToolTip="新增資料夾" Click="AddCategory_Click"/>
                        </Grid>
                        <Button DockPanel.Dock="Bottom" Margin="8,4,8,10" Height="34" Content="＋  新增資料夾" HorizontalContentAlignment="Left" Padding="12,0"
                                Background="Transparent" BorderBrush="#D7E3E0" BorderThickness="1" Foreground="#0F766E" Click="AddCategory_Click"/>
                        <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryList_SelectionChanged"
                                 Margin="8,0,8,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                                 DragOver="CategoryList_DragOver" DragLeave="CategoryList_DragLeave" Drop="CategoryList_Drop"
                                 PreviewMouseLeftButtonUp="CategoryList_PreviewMouseLeftButtonUp"
                                 PreviewMouseRightButtonUp="CategoryList_PreviewMouseRightButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ExpansionGlyph}" FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,3,0"
                                                   ToolTip="左鍵點資料夾可展開 / 收起子資料夾"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border x:Name="FolderDragHandle" Grid.Column="3" Width="24" Height="24" CornerRadius="5" Background="Transparent"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeAll" Tag="{Binding}"
                                                Visibility="{Binding CanDragSidebar, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="按住這裡拖曳：上/下緣＝排序；中央停一下＝放進資料夾"
                                                PreviewMouseLeftButtonDown="FolderDragHandle_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="FolderDragHandle_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="FolderDragHandle_PreviewMouseLeftButtonUp">
                                            <TextBlock Text="⠿" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,9"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#CCFBF1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#EAFBF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#E5E7EB" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" DragCompleted="SidebarSplitter_DragCompleted"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,4,12,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="Auto" MinHeight="32"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SectionTitle" Text="歷史" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11.5" Foreground="#94A3B8" Margin="10,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel x:Name="NormalToolbarPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AddSubfolderButton" Content="＋ 子資料夾" Height="30" Padding="10,0" Margin="0,0,6,0" Visibility="Collapsed"
                                            Background="#ECFDF5" BorderBrush="#A7F3D0" Foreground="#047857" ToolTip="在目前資料夾裡建立子資料夾" Click="AddSubfolder_Click"/>
                                    <Button x:Name="AddFileButton" Content="＋ 檔案" Height="30" Padding="10,0" Margin="0,0,6,0"
                                            Background="#EFF6FF" BorderBrush="#BFDBFE" Foreground="#1D4ED8" ToolTip="加入 MD / TXT / PDF / 圖片" Click="AddFile_Click"/>
                                    <Button x:Name="MultiSelectButton" Content="☑ 選取" Height="30" Padding="10,0" Margin="0,0,5,0"
                                            Background="#F1F5F9" BorderBrush="#DCE3EA" Foreground="#475569" ToolTip="選取多筆；也可以直接 Ctrl / Shift 點卡片空白處" Click="MultiSelectButton_Click"/>
                                    <Button x:Name="EmptyTrashButton" Content="清空最近刪除" Height="30" Padding="10,0" Visibility="Collapsed"
                                            Background="#FFF1F2" BorderBrush="#FECDD3" Foreground="#BE123C" Click="EmptyTrashButton_Click"/>
                                </StackPanel>
                                <Border x:Name="SelectionToolbar" Visibility="Collapsed" Background="#F0FDFA" BorderBrush="#99D9D0" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedCountText" Text="已選 0 項" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="#0F766E" FontSize="11.5" FontWeight="SemiBold"/>
                                        <Button x:Name="SelectAllButton" Content="全選" Height="28" Padding="9,0" Margin="0,0,5,0" Visibility="Collapsed"
                                                Background="White" BorderBrush="#CDEBE6" Foreground="#475569" Click="SelectAllButton_Click"/>
                                        <Button x:Name="DeleteSelectedButton" Content="移除 0" Height="28" Padding="9,0" Margin="0,0,5,0" Visibility="Collapsed"
                                                Background="#FFF1F2" BorderBrush="#FECDD3" Foreground="#BE123C" Click="DeleteSelectedButton_Click"/>
                                        <Button x:Name="PurgeSelectedButton" Content="永久刪除 0" Height="28" Padding="9,0" Margin="0,0,5,0" Visibility="Collapsed"
                                                Background="#7F1D1D" BorderBrush="#991B1B" Foreground="White" Click="PurgeSelectedButton_Click"/>
                                        <Button Content="批次動作 ▾" Click="BatchMenu_Click" Padding="8,3" Margin="4,0"/>
                                        <Button x:Name="ExitMultiSelectButton" Content="完成" Height="28" Padding="10,0" Background="White" BorderBrush="#CDEBE6" Foreground="#0F766E" Click="ExitMultiSelectButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                        <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                            <Button x:Name="FilterAllButton" Style="{StaticResource FilterChip}" Tag="All" Content="全部" Click="ContentFilter_Click"/>
                            <Button x:Name="FilterTextButton" Style="{StaticResource FilterChip}" Tag="Text" Content="文字" Click="ContentFilter_Click"/>
                            <Button x:Name="FilterImageButton" Style="{StaticResource FilterChip}" Tag="Image" Content="圖片" Click="ContentFilter_Click"/>
                            <Button x:Name="FilterFilesButton" Style="{StaticResource FilterChip}" Tag="Files" Content="檔案" Click="ContentFilter_Click"/>
                            <RadioButton x:Name="StandardViewButton" GroupName="CardViewMode" Style="{StaticResource ViewModeButton}"
                                         Content="A 標準" Margin="3,0,2,0" ToolTip="標準卡片" Click="ViewMode_Click"/>
                            <RadioButton x:Name="CompactViewButton" GroupName="CardViewMode" Style="{StaticResource ViewModeButton}"
                                         Content="B 緊湊" Margin="0,0,3,0" ToolTip="緊湊列表：同一畫面顯示更多紀錄" Click="ViewMode_Click"/>
                            <Button Content="檢視 / 工具 ▾" Click="ProductMenu_Click" Padding="8,3" Margin="6,0"/>
                            <TextBlock x:Name="SectionHintText" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="#94A3B8"
                                       Text="歷史＝最近複製 / 擷取；刪除歷史不會刪掉已整理的原資料"/>
                        </WrapPanel>
                    </Grid>

                    <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="White" Margin="14,0,14,10"
                             SelectionMode="Single" MouseDoubleClick="HistoryList_MouseDoubleClick" PreviewMouseRightButtonUp="HistoryList_PreviewMouseRightButtonUp"
                             PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="HistoryList_PreviewMouseLeftButtonUp"
                             MouseMove="HistoryList_MouseMove" PreviewMouseWheel="HistoryList_PreviewMouseWheel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AllowDrop="True"
                             DragOver="HistoryList_DragOver" Drop="HistoryList_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="RequestBringIntoView" Handler="ClipRow_RequestBringIntoView"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" BorderBrush="#E6EAF0" BorderThickness="1" CornerRadius="12" Background="White" Padding="12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#99D9D0"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#FCFFFE"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#0D9488"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#F0FDFA"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#0D9488"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#E8FFFA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Compact}" Value="True">
                                                    <Setter TargetName="Bd" Property="Padding" Value="8"/>
                                                    <Setter TargetName="Bd" Property="CornerRadius" Value="8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Compact}" Value="True">
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Margin="0,2,10,0" VerticalAlignment="Top"
                                              Width="22" Height="22" IsChecked="{Binding IsMarked, Mode=TwoWay}"
                                              Visibility="{Binding ShowSelector, Converter={StaticResource BoolToVisibility}}"
                                              Tag="{Binding}" ToolTip="選取這筆" Click="ItemMark_Click"/>

                                    <!-- Compact hierarchy: custom title only; metadata stays under ⋯ > 詳細資訊. -->
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="19" Height="24" CornerRadius="4" Background="#F1F5F9" Cursor="SizeAll"
                                                Tag="{Binding}" ToolTip="拖曳到左側資料夾"
                                                PreviewMouseLeftButtonDown="ClipDragHandle_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="ClipDragHandle_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="ClipDragHandle_PreviewMouseLeftButtonUp">
                                            <Border.Style><Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="0.8"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="0.8"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style></Border.Style>
                                            <TextBlock Text="⠿" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="3,0,4,0">
                                            <Button Tag="{Binding}" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                    ToolTip="點擊修改自訂標題" Click="RenameTitle_Click">
                                                <Button.Style><Style TargetType="Button"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers></Style></Button.Style>
                                                <Border BorderBrush="#0D9488" BorderThickness="2,0,0,0" Padding="8,3" Background="Transparent">
                                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#172033"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                </Border>
                                            </Button>
                                            <TextBox x:Name="ClipTitleEditor"
                                                     Text="{Binding DraftTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="16" Padding="7,3" AcceptsReturn="False"
                                                     Foreground="#172033" Background="#F0FDFA" BorderBrush="#0D9488" BorderThickness="1"
                                                     ToolTip="Enter 儲存 · Esc 取消 · 點外保留草稿"
                                                     ContextMenuOpening="InlineTitle_ContextMenuOpening">
                                                <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers></Style></TextBox.Style>
                                            </TextBox>
                                            <Button Content="＋ 標題" Tag="{Binding}" HorizontalAlignment="Left" Padding="4,1" Margin="0"
                                                    FontSize="11" Foreground="#64748B" Background="Transparent" BorderThickness="0"
                                                    ToolTip="新增自訂標題" Click="RenameTitle_Click">
                                                <Button.Style><Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Title}" Value=""/>
                                                            <Condition Binding="{Binding IsEditingTitle}" Value="False"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Title}" Value=""/>
                                                            <Condition Binding="{Binding IsEditingTitle}" Value="False"/>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <!-- The right-side blank area is card chrome, separate from selectable text.
                                         Ctrl/Shift clicks use Windows-style multi-select; an ordinary click on an
                                         expanded card can still collapse it without stealing text selection. -->
                                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Background="Transparent"
                                            Margin="10,4,0,0" Tag="{Binding}" Cursor="Hand"
                                            ToolTip="右側空白：Ctrl 單選／Shift 連選；展開時一般點擊可收起"
                                            MouseLeftButtonDown="CollapseContentBlankArea_MouseLeftButtonDown"/>

                                    <Grid Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource CardActionButton}" Content="{Binding FavoriteGlyph}" Tag="{Binding}"
                                                    FontSize="20" Foreground="#0EA5E9" ToolTip="收藏／取消收藏" Click="FavoriteButton_Click"/>
                                            <!-- Less-used actions remain reachable through ⋯, but surface on hover/selection. -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style><Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></StackPanel.Style>
                                                <Button Content="✎" Tag="{Binding}" FontSize="17" Width="30" Height="28" Padding="0"
                                                        Foreground="#0F766E" Background="Transparent" BorderThickness="0" Focusable="False"
                                                        ToolTip="編輯正文" Click="EditBody_Click">
                                                    <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Text"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style></Button.Style>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButton}" Content="▣" Tag="{Binding}"
                                                        FontSize="17" Foreground="#0EA5E9" ToolTip="複製" Click="CopyButton_Click"/>
                                                <Button Style="{StaticResource CardDangerActionButton}" Content="−" Tag="{Binding}"
                                                        FontSize="16" ToolTip="移出此區域或移到最近刪除（可恢復）" Click="DeleteButton_Click"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource CardActionButton}" Content="⋯" Tag="{Binding}"
                                                    FontSize="20" ToolTip="更多操作／詳細資訊" Click="MoreButton_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="↩" Tag="{Binding}" Width="42" Height="32" FontSize="18" Background="#ECFDF5" BorderBrush="#A7F3D0" Foreground="#047857" ToolTip="復原到刪除前的資料位置" Click="RestoreButton_Click"/>
                                            <Button Content="🗑" Tag="{Binding}" Width="42" Height="32" FontSize="16" Background="#FFF1F2" BorderBrush="#FECDD3" Foreground="#BE123C" ToolTip="永久刪除；確認後仍有 8 秒可以反悔" Click="PurgeButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPendingPurge}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0"
                                                Visibility="{Binding IsInlineEditing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Foreground="#0F766E" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="編輯文字中 · Ctrl+Enter 儲存 · Esc 取消"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsEditingTitle}" Value="True"><Setter Property="Text" Value="修改標題中 · Enter 儲存 · Esc 取消"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="儲存" FontSize="11" Padding="6,2" Margin="0,0,5,0" Focusable="False" Click="SaveInlineEdit_Click"
                                                Background="#CCFBF1" BorderBrush="#99F6E4" Foreground="#0F766E"/>
                                        <Button Content="取消" FontSize="11" Padding="6,2" Focusable="False" Click="CancelInlineEdit_Click"
                                                Background="#F8FAFC" BorderBrush="#E2E8F0" Foreground="#64748B"/>
                                    </WrapPanel>

                                    <TextBox x:Name="ClipSelectableText" Grid.Row="2" Grid.Column="1" Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsTextReadOnly}"
                                             IsReadOnlyCaretVisible="True" AcceptsReturn="True" IsUndoEnabled="True"
                                             BorderThickness="0" Padding="0"
                                             Foreground="#172033" TextWrapping="Wrap" MaxHeight="{Binding ContentMaxHeight}"
                                             HorizontalScrollBarVisibility="Disabled"
                                             FocusVisualStyle="{x:Null}" Cursor="IBeam" SelectionBrush="#99F6E4" SelectionOpacity="0.75" IsInactiveSelectionHighlightEnabled="True"
                                             PreviewMouseLeftButtonDown="ClipSelectableText_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="ClipSelectableText_PreviewMouseMove" PreviewMouseLeftButtonUp="ClipSelectableText_PreviewMouseLeftButtonUp"
                                             PreviewMouseWheel="ClipSelectableText_PreviewMouseWheel"
                                             ContextMenuOpening="ClipSelectableText_ContextMenuOpening" PreviewKeyDown="ClipSelectableText_PreviewKeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Margin" Value="0,7,4,0"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Compact}" Value="True">
                                                        <Setter Property="Margin" Value="0,4,4,0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsContentExpanded}" Value="True">
                                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEditingText}" Value="True">
                                                        <Setter Property="Background" Value="#F0FDFA"/>
                                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Row="3" Grid.Column="1" Content="收起 ↑" Tag="{Binding}" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Padding="8,3" FontSize="10.5" Foreground="#0F766E" Background="#F0FDFA"
                                            BorderBrush="#99F6E4" BorderThickness="1" Cursor="Hand"
                                            Visibility="{Binding IsContentExpanded, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="收起完整內容預覽" Click="CollapseContentButton_Click"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1"><TextBlock Text="{Binding SearchExcerpt}" TextWrapping="Wrap" MaxHeight="44" Foreground="#0F766E" FontSize="12" Margin="0,5,0,0"/>
                                    <Image Grid.Column="1" Source="{Binding PreviewImage}" MaxHeight="180" MaxWidth="280" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <Border x:Name="UndoBar" Grid.Row="1" Panel.ZIndex="40" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,18"
                    Background="#172033" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UndoBarText" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="復原" Padding="12,4" Background="#CCFBF1" BorderBrush="#99F6E4" Foreground="#0F766E"
                            FontWeight="SemiBold" Click="UndoBarButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Footer: user-facing status only; engineering process details live in Settings / diagnostics. -->
            <Grid Grid.Row="2" Background="#F8FAFC">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="15,0,12,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="10.5"
                           Text="Ctrl+~ 隱藏　Ctrl / Shift 點卡片空白可多選"/>
                <TextBlock x:Name="CaptureStateText" Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#0F766E" FontSize="10.5" FontWeight="SemiBold" Text="已自動儲存"/>
                <TextBlock Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="10.5" Text="本機保存" ToolTip="內容保存在本機，不上傳雲端"/>
                <TextBlock x:Name="ModeStateText" Visibility="Collapsed"/>
                <ResizeGrip Grid.Column="2" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" ToolTip="拖曳調整視窗大小"/>
            </Grid>
        </Grid>
    </Border>
</Window>
