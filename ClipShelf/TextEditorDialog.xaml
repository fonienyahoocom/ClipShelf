<Window x:Class="ClipShelf.TextEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增文字" Width="560" Height="570"
        WindowStartupLocation="CenterOwner" MinWidth="480" MinHeight="360"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DialogHeading" Text="自己新增文字" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="標題（選填）" Margin="0,12,0,4"/><TextBox x:Name="TitleBox" Padding="8"/>
            <TextBlock Text="備註（選填）" Margin="0,8,0,4"/><TextBox x:Name="NoteBox" Padding="8"/>
            <TextBlock x:Name="DialogSubheading" Text="Enter 直接加入 · Shift+Enter 換行。" Margin="0,4,0,0" Foreground="#64748B" FontSize="12"/>
        </StackPanel>

        <TextBox x:Name="TextBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontSize="15" Padding="10" BorderBrush="#CBD5E1" PreviewKeyDown="TextBox_PreviewKeyDown"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="存到：" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="FavoriteCheck" Grid.Column="2" Content="收藏" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <CheckBox x:Name="TemporaryCheck" Grid.Column="3" Content="暫存" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Width="88" Height="34" Margin="0,0,10,0" Content="加入" IsDefault="True"
                    Background="#0F766E" BorderBrush="#0F766E" Foreground="White" FontWeight="SemiBold" Click="Add_Click"/>
            <Button Width="88" Height="34" Content="取消" IsCancel="True" Background="White" BorderBrush="#CBD5E1" Foreground="#475569" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
