<Window x:Class="ClipShelf.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="輸入" Width="440" Height="245" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="18" BorderBrush="#DDE7E5" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" Background="#CCFBF1" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="新增資料夾" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock x:Name="PromptText" Text="輸入一個容易辨認的名稱" Margin="0,3,0,0" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
                <Button Grid.Column="2" Content="×" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="#64748B" FontSize="20" ToolTip="取消" Click="Cancel_Click"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="資料夾名稱" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Height="46">
                <TextBox x:Name="ValueBox" BorderThickness="0" Background="Transparent" FontSize="16"
                         Padding="12,0" VerticalContentAlignment="Center" MaxLength="60"
                         TextChanged="ValueBox_TextChanged"/>
            </Border>
            <TextBlock x:Name="ValidationText" Grid.Row="5" Margin="4,6,0,0" FontSize="11" Foreground="#BE185D"/>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Text="Enter 建立　Esc 取消"/>
                <Button Grid.Column="1" Content="取消" Height="38" IsCancel="True" Background="#F1F5F9" BorderBrush="#CBD5E1"
                        Foreground="#334155" Click="Cancel_Click"/>
                <Button x:Name="PrimaryButton" Grid.Column="3" Content="建立" Height="38" IsDefault="True"
                        Background="#0F766E" BorderBrush="#0F766E" Foreground="White" FontWeight="SemiBold" Click="Ok_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
