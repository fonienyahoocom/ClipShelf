+name: ClipShelf Windows Build
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+permissions:
+  contents: read
+concurrency:
+  group: clipshelf-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+jobs:
+  windows:
+    if: github.event_name == 'push' || github.event.pull_request.head.repo.full_name == github.repository
+    runs-on: windows-2022
+    timeout-minutes: 25
+    steps:
+      - name: Checkout exact source
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4, verified 2026-10-11
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Checkout comparison baseline
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.event.pull_request.base.sha || github.event.before != '0000000000000000000000000000000000000000' && github.event.before || github.sha }}
+          path: .ci-baseline
+          persist-credentials: false
+      - name: Install .NET 8 SDK
+        uses: actions/setup-dotnet@67a3573c9a986a3f9c594539f4ab511d57bb3ce9 # v4
+        with:
+          dotnet-version: 8.0.425
+      - name: Install Python
+        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
+        with:
+          python-version: '3.12'
+      - name: Install package inspection and NSIS
+        shell: pwsh
+        run: |
+          python -m pip install pefile==2024.8.26
+          if ($LASTEXITCODE -ne 0) { throw 'pefile install failed' }
+          choco install nsis --version=3.11 -y --no-progress
+          if ($LASTEXITCODE -notin 0,3010) { throw 'NSIS install failed' }
+      - name: Tests, publish, installer and byte verification
+        shell: pwsh
+        env:
+          DOTNET_CLI_TELEMETRY_OPTOUT: '1'
+          DOTNET_NOLOGO: '1'
+        run: |
+          $nsis = Join-Path ${env:ProgramFiles(x86)} 'NSIS\makensis.exe'
+          $sevenzip = Join-Path $env:ProgramFiles '7-Zip\7z.exe'
+          if (!(Test-Path $nsis) -or !(Test-Path $sevenzip)) { throw 'Required packaging tool missing' }
+          $baseline = "$env:GITHUB_WORKSPACE\.ci-baseline"
+          if (!(Test-Path "$baseline\ClipShelf\HistoryStore.cs")) {
+            python CI_BASELINE.py
+            if ($LASTEXITCODE -ne 0) { throw 'Initial baseline hash verification failed' }
+            $baseline = "$env:GITHUB_WORKSPACE\.ci-initial-baseline"
+          }
+          python BUILD_PORTABLE.py --baseline $baseline --output "$env:GITHUB_WORKSPACE\out" --dotnet (Get-Command dotnet).Source --makensis $nsis --sevenzip $sevenzip
+          if ($LASTEXITCODE -ne 0) { throw 'Build or verification failed' }
+          python CI_RELEASE.py
+          if ($LASTEXITCODE -ne 0) { throw 'Release report failed' }
+      - name: Upload checked release
+        if: success()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: clipshelf-release-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            out/ClipShelf-*-Source.zip
+            out/ClipShelf-*-Setup.exe
+            out/ClipShelf-*-BuildReceipt.json
+            out/ClipShelf-*-版本交付清單.json
+            out/ClipShelf-*-更新說明與測試結果.md
+            out/ClipShelf-*-使用說明.txt
+          if-no-files-found: error
+          retention-days: 7
+          compression-level: 0
+      - name: Upload validation logs even on failure
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: clipshelf-logs-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            validation/*.log
+            validation/package-checks.json
+            validation/commands.json
+          if-no-files-found: warn
+          retention-days: 7
