<Window x:Class="ClipShelf.ImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="匯入預覽" Width="520" Height="465"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="匯入前掃描完成" FontSize="21" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="目前尚未寫入 History，也沒有把備份內容解到 ClipShelf storage。"
                       Margin="0,5,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="確定是新內容" Foreground="#0F172A"/>
                <TextBlock x:Name="NewItemsText" Grid.Column="1" FontWeight="SemiBold" Foreground="#047857"/>

                <TextBlock Grid.Row="2" Text="同一筆 ID，已存在" Foreground="#475569"/>
                <TextBlock x:Name="DuplicateIdText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="4" Text="內容相同，預設跳過" Foreground="#475569"/>
                <TextBlock x:Name="DuplicateContentText" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="6" Text="無法安全判定是否重複" Foreground="#475569"/>
                <TextBlock x:Name="UncertainText" Grid.Row="6" Grid.Column="1" FontWeight="SemiBold" Foreground="#B45309"/>

                <TextBlock Grid.Row="8" Text="新增資料夾／子資料夾" Foreground="#475569"/>
                <TextBlock x:Name="NewFoldersText" Grid.Row="8" Grid.Column="1" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <TextBlock x:Name="BackupInfoText" Grid.Row="4" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>

        <Border Grid.Row="6" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="預設只匯入確定的新內容。ID 重複與內容重複都不會建立第二份。"
                           Foreground="#9A3412" TextWrapping="Wrap"/>
                <CheckBox x:Name="IncludeUncertainCheckBox" Margin="0,10,0,0"
                          Content="也匯入無法安全判定的項目（可能產生重複）"
                          Foreground="#7C2D12" Checked="IncludeUncertain_Changed" Unchecked="IncludeUncertain_Changed"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="WarningText" Grid.Row="7" Margin="0,12,0,0" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="96" Height="36" Margin="0,0,10,0" Content="取消" Click="Cancel_Click"/>
            <Button x:Name="ImportButton" Width="118" Height="36" Content="匯入新內容" IsDefault="True" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
