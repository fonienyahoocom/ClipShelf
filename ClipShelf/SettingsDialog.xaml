<Window x:Class="ClipShelf.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipShelf 設定" Width="520" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="快捷選取" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock x:Name="HotkeyStatus" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="#64748B"/>
                <ComboBox x:Name="PickerHotkey" Height="34" FontSize="14" Margin="0,0,0,16">
                    <ComboBoxItem Content="Ctrl + ~（預設）" Tag="192"/>
                    <ComboBoxItem Content="Ctrl + Alt + V" Tag="86"/>
                    <ComboBoxItem Content="Ctrl + Alt + Q" Tag="81"/>
                </ComboBox>
                <TextBlock Text="自動保存" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Text="決定哪些剪貼簿內容要自動進入 ClipShelf。" Margin="0,4,0,12" Foreground="#64748B" FontSize="12"/>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <CheckBox x:Name="CaptureTextCheck" Content="自動保存文字" FontSize="15" Margin="0,0,0,12"/>
                        <CheckBox x:Name="CaptureImagesCheck" Content="自動保存圖片" FontSize="15" Margin="0,0,0,12"/>
                        <CheckBox x:Name="CaptureFilesCheck" Content="自動保存檔案 / 資料夾" FontSize="15"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="歷史保留數量" FontSize="20" FontWeight="SemiBold" Foreground="#172033" Margin="0,20,0,0"/>
                <TextBlock Text="超過數量時，自動刪除最舊的一般歷史。" Margin="0,4,0,12" Foreground="#64748B" FontSize="12"/>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="最多保留" VerticalAlignment="Center" FontSize="15" Margin="0,0,12,0"/>
                            <TextBox x:Name="MaxItemsBox" Height="34" Padding="8,4" FontSize="15" PreviewTextInput="MaxItemsBox_PreviewTextInput"/>
                        </DockPanel>
                        <TextBlock Text="輸入 0 代表不限數量。收藏、暫存、已分類項目不會被自動刪除。"
                                   Margin="0,10,0,0" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="FloatingIconCheck" Content="顯示桌面浮動圖示（獨立於管理／快捷視窗）" Margin="0,18,0,0" FontSize="14"/>
                <TextBlock Text="最近刪除" FontSize="20" FontWeight="SemiBold" Foreground="#172033" Margin="0,20,0,0"/>
                <TextBlock Text="一般刪除先進入「最近刪除」，到期後才會真正清除。" Margin="0,4,0,12" Foreground="#64748B" FontSize="12"/>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="保留時間" VerticalAlignment="Center" FontSize="15" Margin="0,0,12,0"/>
                            <ComboBox x:Name="TrashRetentionCombo" Height="34" FontSize="14" SelectedValuePath="Tag">
                                <ComboBoxItem Content="7 天" Tag="7"/>
                                <ComboBoxItem Content="30 天（建議）" Tag="30"/>
                                <ComboBoxItem Content="90 天" Tag="90"/>
                                <ComboBoxItem Content="永不自動清除" Tag="0"/>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="永久刪除仍會提供短暫反悔時間；超過反悔時間後，ClipShelf 管理的圖片 / 檔案也會一起清除。"
                                   Margin="0,10,0,0" Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="檔案 / 圖片儲存位置" FontSize="20" FontWeight="SemiBold" Foreground="#172033" Margin="0,20,0,0"/>
                <TextBlock Text="手動匯入的 MD、TXT、PDF、圖片，以及新擷取的圖片會存到這裡。"
                           Margin="0,4,0,12" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBox x:Name="StoragePathBox" Height="36" Padding="8,5" FontSize="13" VerticalContentAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Width="96" Height="34" Margin="0,0,8,0" Content="選擇位置…" Click="BrowseStorage_Click"/>
                            <Button Width="112" Height="34" Content="打開存放位置" Click="OpenStorage_Click"/>
                        </StackPanel>
                        <TextBlock Text="更換位置後，新加入的檔案會存到新位置；舊項目仍保留原來的檔案路徑。"
                                   Margin="0,10,0,0" Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="92" Height="36" Margin="0,0,10,0" Content="取消" Click="Cancel_Click"/>
            <Button Width="92" Height="36" Content="儲存" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
